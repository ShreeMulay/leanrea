{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "rootDir": ".",
    "outDir": "build"
  },
  "include": [
    "src/**/*.ts",
    "test/**/*.ts",
    "scripts/**/*.ts",
    "bench/**/*.ts"
  ],
  "exclude": [
    "node_modules",
    "dist",
    "build",
    "bench/work",
    "test/fixtures"
  ]
}
